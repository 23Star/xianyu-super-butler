# Shell scripts use Unix line endings.
*.sh text eol=lf
entrypoint.sh text eol=lf

# Windows batch files use Windows line endings.
*.bat text eol=crlf

# Source and configuration files use Unix line endings.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.conf text eol=lf

# Documentation uses Unix line endings.
*.md text eol=lf
*.txt text eol=lf

# Binary assets are not normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
